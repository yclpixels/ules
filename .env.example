DATABASE_URL="file:./prisma/dev.db"

# Oturum imzalama anahtarı
SESSION_SECRET="openssl rand -base64 32 ile üretin"

# İlk şube + müdür hesabı `npm run db:seed` ile oluşturulur (bkz. prisma/seed.ts).
# İkinci bir şube açmak için bunları değiştirip seed'i tekrar çalıştırın.
SEED_BRANCH_NAME="Ana Şube"
SEED_MANAGER_USERNAME="yonetici"
SEED_MANAGER_PASSWORD="change-me"

# Ödeme sağlayıcısı: "mock" (demo, gerçek tahsilat yok) veya "iyzico"
PAYMENT_PROVIDER="mock"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Ödeme tamamlandığında/hesap kapandığında POS/kasa sistemine bildirim göndermek için (opsiyonel)
POS_WEBHOOK_URL=""

# Fiş e-postası: SMTP_HOST boşsa demo modu (sadece konsola loglar)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
