DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani"

# Sitenin canlıdaki tam adresi. SEO (metadataBase, sitemap.xml, robots.txt,
# OG görselleri) ve iyzico callback URL'i bunu kullanır. Prod'da mutlaka
# gerçek domain ile ("https://ules.com.tr" gibi) tanımlayın — boşsa
# geliştirmede localhost'a, istekteki Host başlığına düşer.
#
# DİKKAT: NEXT_PUBLIC_ değişkenleri `next build` anında koda gömülür; Docker
# build'inde ARG olarak geçer (bkz. Dockerfile). Sunucu tarafı (iyzico dönüş
# adresi, e-posta linkleri) ayrıca runtime'da APP_URL'i okur — ikisine de
# aynı değeri verin.
NEXT_PUBLIC_APP_URL=""
APP_URL=""

# Uygulamanın önündeki proxy sayısı (istemci IP'sini X-Forwarded-For'dan
# güvenle okumak için, bkz. src/lib/rateLimit.ts). Railway/Render/Fly: 1.
# Cloudflare + Railway: 2. Proxy yoksa 0 (bu durumda tüm IP sınırları tek
# ortak kovaya düşer — önerilmez).
TRUSTED_PROXY_HOPS="1"

# Demo ve destek taleplerinin geleceği BİZİM gelen kutumuz. Talepler ayrıca
# veritabanına kaydedilir ve /admin/talepler'de görünür (e-posta gitmese bile).
SUPPORT_EMAIL=""

# Oturum imzalama anahtarı
SESSION_SECRET="openssl rand -base64 32 ile üretin"

# İlk şube + müdür hesabı `npm run db:seed` ile oluşturulur (bkz. prisma/seed.ts).
# İkinci bir şube açmak için bunları değiştirip seed'i tekrar çalıştırın.
SEED_BRANCH_NAME="Ana Şube"
SEED_MANAGER_USERNAME="yonetici"
SEED_MANAGER_PASSWORD="change-me"

# Ödeme sağlayıcısı: "mock" (demo, gerçek tahsilat yok) veya "iyzico"
PAYMENT_PROVIDER="mock"
# Prod'da mock ile kartlı ödeme varsayılan olarak engellenir (müşteri hesabı
# bedava kapatmasın). Bilinçli bir demo kurulumu için "true" yapın.
ALLOW_MOCK_PAYMENTS=""
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Ödeme tamamlandığında/hesap kapandığında POS/kasa sistemine bildirim göndermek için (opsiyonel)
POS_WEBHOOK_URL=""
# Doluysa webhook istekleri HMAC ile imzalanır (X-Ules-Signature/X-Ules-Timestamp,
# bkz. src/lib/posWebhook.ts). `openssl rand -hex 32` ile üretin.
POS_WEBHOOK_SECRET=""

# E-posta gönderimi (fiş, düşük puan uyarısı, demo/destek talepleri).
# Öncelik: RESEND_API_KEY → SMTP_HOST → demo modu (sadece konsola yazar).
#
# RAILWAY FREE/TRIAL/HOBBY PLANLARINDA GİDEN SMTP KAPALIDIR — orada Resend
# (HTTPS API) kullanın: resend.com → alan adını doğrulayın → API anahtarı.
RESEND_API_KEY=""
# Gönderen adres; alan adı Resend'de doğrulanmış olmalı.
EMAIL_FROM="Üleş <bildirim@xn--le-wka21b.com>"

# Sadece Railway Pro ya da SMTP'ye izin veren bir barındırmada:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Ürün görsellerinin yazılacağı klasör (boşsa proje içindeki ./uploads).
# Docker'da volume olarak bağlanmalı, yoksa container yenilenince kaybolur.
UPLOAD_DIR=""

# Platformun (Üleş) kendi şirket kimliği — /kullanim-sartlari sayfasında
# görünür. Şirket kuruluşu tamamlanınca doldurun; boşsa sayfa "şablon"
# uyarısıyla gösterilir.
PLATFORM_LEGAL_NAME=""
PLATFORM_CONTACT_EMAIL=""

# IBAN ve TC kimlik no'yu veritabanında şifrelemek için (AES-256-GCM,
# bkz. src/lib/fieldCrypto.ts). `openssl rand -base64 32` ile üretin.
# ANAHTAR KAYBOLURSA ŞİFRELİ ALANLAR OKUNAMAZ — ayrı bir yerde yedekleyin.
# Tanımlı değilse alt üye işyeri kaydı yapılamaz.
FIELD_ENCRYPTION_KEY=""
