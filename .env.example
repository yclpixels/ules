DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani"

# Sitenin canlıdaki tam adresi. SEO (metadataBase, sitemap.xml, robots.txt,
# OG görselleri) ve iyzico callback URL'i bunu kullanır. Prod'da mutlaka
# gerçek domain ile ("https://ules.com.tr" gibi) tanımlayın — boşsa
# geliştirmede localhost'a, istekteki Host başlığına düşer.
NEXT_PUBLIC_APP_URL=""

# Oturum imzalama anahtarı
SESSION_SECRET="openssl rand -base64 32 ile üretin"

# İlk şube + müdür hesabı `npm run db:seed` ile oluşturulur (bkz. prisma/seed.ts).
# İkinci bir şube açmak için bunları değiştirip seed'i tekrar çalıştırın.
SEED_BRANCH_NAME="Ana Şube"
SEED_MANAGER_USERNAME="yonetici"
SEED_MANAGER_PASSWORD="change-me"

# Ödeme sağlayıcısı: "mock" (demo, gerçek tahsilat yok) veya "iyzico"
PAYMENT_PROVIDER="mock"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Ödeme tamamlandığında/hesap kapandığında POS/kasa sistemine bildirim göndermek için (opsiyonel)
POS_WEBHOOK_URL=""

# Fiş e-postası: SMTP_HOST boşsa demo modu (sadece konsola loglar)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Ürün görsellerinin yazılacağı klasör (boşsa proje içindeki ./uploads).
# Docker'da volume olarak bağlanmalı, yoksa container yenilenince kaybolur.
UPLOAD_DIR=""

# Platformun (Üleş) kendi şirket kimliği — /kullanim-sartlari sayfasında
# görünür. Şirket kuruluşu tamamlanınca doldurun; boşsa sayfa "şablon"
# uyarısıyla gösterilir.
PLATFORM_LEGAL_NAME=""
PLATFORM_CONTACT_EMAIL=""
