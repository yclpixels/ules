// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String   // "Kadıköy Şubesi" vb.
  createdAt DateTime @default(now())

  // Ödeme sonrası müşteriyi yönlendireceğimiz Google yorum linki
  // (Google Business Profile → "Yorum isteyin" → g.page/r/... linki). Boşsa adım atlanır.
  googleReviewUrl String?
  // Ödeme ekranında sunulan bahşiş yüzdeleri, virgülle: "5,10,15". Boşsa bahşiş adımı gizlenir.
  tipPresets      String  @default("5,10,15")

  // Herkese açık menü sayfasının adresi: /menu/<menuSlug>.
  // İşletme bunu kendi sitesine gömebilir, sitesi yoksa Instagram/WhatsApp'ta
  // paylaşır. Boşsa sayfa yayında değildir.
  menuSlug String? @unique

  // İşletmenin kendi sitesi / Instagram adresi; müşteri ekranında link olarak görünür.
  websiteUrl String?

  // Menünün sunulduğu diller, virgülle: "tr,en". İlki ana dildir ve
  // Product/Category üzerindeki temel alanlara karşılık gelir.
  supportedLocales String @default("tr")

  // Düşük puan geldiğinde uyarı gönderilecek e-posta (opsiyonel).
  // Boşsa sadece panel içi uyarı gösterilir.
  alertEmail String?

  // Müşterinin QR'dan kendi siparişini verip veremeyeceği. Varsayılan KAPALI:
  // pilotta QR sadece menü + hesap görüntüleme olarak başlar, siparişi garson
  // girer. Restoran sisteme güvendikten sonra açılır.
  customerOrderingEnabled Boolean @default(false)

  // Abonelik durumu. Tahsilat kodda değil (fatura + EFT); burada sadece
  // hangi şubenin ne durumda olduğu tutulur.
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  monthlyFeeCents    Int? // anlaşılan aylık ücret (kuruş), bilgi amaçlı
  subscriptionNote   String? // "3 Ekim'de ödendi", "2 hafta ek süre verildi" vb.

  // Müşterinin QR'dan kartla ödeme yapıp yapamayacağı. Varsayılan KAPALI:
  // kartlı ödeme açmak, o şube için gerçek bir üye işyeri (iyzico vb.)
  // anlaşması gerektirir — para asla bizim hesabımızdan geçmez. Kapalıyken
  // müşteri hesabı görür ve payını hesaplar, tahsilatı personel yapar.
  cardPaymentEnabled Boolean @default(false)

  // KVKK aydınlatma metni için işletme kimliği (veri sorumlusu). Boşsa
  // /gizlilik sayfası "doldurulmamış şablon" uyarısıyla gösterilir.
  legalName    String? // resmi unvan, ör. "Örnek Gıda San. Tic. Ltd. Şti."
  legalAddress String?
  contactEmail String?
  contactPhone String?

  // iyzico Pazaryeri (alt üye işyeri): kartlı ödeme tahsilatının doğrudan bu
  // şubenin kendi hesabına düşmesi için gerekli. subMerchantKey iyzico'dan
  // dönen ve ödeme isteklerinde kullanılan anahtardır; boşsa bu şube için alt
  // üye kaydı henüz yapılmamış demektir — para o zamana kadar tahsil edilmez.
  subMerchantType     SubMerchantType?
  ibanNumber          String?
  taxOffice           String?
  taxNumber           String?
  identityNumber      String? // PERSONAL tipinde TC kimlik no
  subMerchantKey      String?
  subMerchantSyncedAt DateTime?
  // Platformun bu şubeden aldığı komisyon (baz puan, 100 = %1). Sözleşmeyle
  // belirlenip burada girilene kadar 0'dır — yani platform hiçbir pay almaz,
  // tahsilatın tamamı şubeye gider.
  platformCommissionBp Int @default(0)

  tables     Table[]
  categories Category[]
  products   Product[]
  staff      StaffUser[]
  feedbacks  Feedback[]
  dayCloses  DayClose[]
  auditLogs  AuditLog[]
}

/// KVKK "veri güvenliği tedbirleri" kapsamında erişim/işlem kaydı.
/// Kim, ne zaman, hangi hassas işlemi yaptı — silinmez, sadece eklenir.
/// Sipariş kalemi ekleme gibi rutin işler burada tutulmaz (OrderItem.addedBy'da zaten var);
/// burası oturum açma ve geri alınamaz/para etkileyen işlemler için.
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // LOGIN_SUCCESS, LOGIN_FAILED, ORDER_CANCELLED, ...
  actorName String   // işlemi yapan personelin adı (başarısız girişte denenen kullanıcı adı)
  actorId   String?  // StaffUser.id; başarısız girişte boş
  detail    String?  // insan tarafından okunur kısa açıklama
  ip        String?
  createdAt DateTime @default(now())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
}

/// Ödeme sonrası müşteri değerlendirmesi (1–5 yıldız, 4 kriter + yorum).
model Feedback {
  id            String   @id @default(cuid())
  foodRating    Int
  serviceRating Int
  ambianceRating Int
  valueRating   Int
  comment       String?
  createdAt     DateTime @default(now())

  // Düşük puan uyarısı: müdür "Gördüm" deyince işaretlenir, uyarı bandından düşer.
  acknowledgedAt DateTime?
  acknowledgedBy String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model Table {
  id        String   @id @default(cuid())
  name      String   // "Masa 1", "Bahçe 3" vb.
  qrToken   String   @unique @default(cuid())
  createdAt DateTime @default(now())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  orders Order[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  products     Product[]
  translations CategoryTranslation[]
}

/// Kategorinin bir dildeki adı. Kayıt yoksa Category.name kullanılır.
model CategoryTranslation {
  id     String @id @default(cuid())
  locale String
  name   String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int      // kuruş cinsinden fiyat (yuvarlama hatalarını önlemek için)
  isAvailable Boolean  @default(true)
  imageUrl    String?  // https://... (harici görsel linki; dosya yükleme yok, hosting bağımsız kalsın diye)
  allergens   String?  // "gluten, süt, fındık" gibi serbest metin
  createdAt   DateTime @default(now())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  orderItems   OrderItem[]
  translations ProductTranslation[]
}

/// Ürünün bir dildeki karşılığı. Kayıt yoksa Product'taki temel alanlar kullanılır.
model ProductTranslation {
  id          String  @id @default(cuid())
  locale      String // "en", "de", "ar" ...
  name        String
  description String?
  allergens   String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED // personel tarafından iptal/ikram edildi; ciroya girmez
}

model Order {
  id        String      @id @default(cuid())
  status    OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())
  closedAt  DateTime?
  closedBy  String?     // hesabı elle kapatan/iptal eden personel (ödemeyle otomatik kapandıysa boş)

  // Masa başına aynı anda tek açık hesap garantisi: sipariş OPEN iken tableId
  // ile doldurulur, kapanınca null yapılır (unique kısıtı null'ları saymaz).
  openTableKey String? @unique

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  items    OrderItem[]
  payments Payment[]
  feedbacks Feedback[]
}

model OrderItem {
  id             String    @id @default(cuid())
  quantity       Int       @default(1)
  unitPriceCents Int       // eklendiği andaki fiyat (ürün fiyatı sonradan değişse bile hesap sabit kalır)
  note           String?
  createdAt      DateTime  @default(now())
  addedBy        String?   // ekleyen personelin adı; müşteri kendi eklediyse boş

  removedAt DateTime? // silinen ürünler hesaptan düşer ama kayıt (audit) için saklanır
  removedBy String?

  // Mutfak ekranı: hazırlanan kalem listeden düşer. Ödemeyle ilgisi yoktur.
  preparedAt DateTime?
  preparedBy String?

  // "Kalemleri seç" ile ödeme: bu kalemi hangi ödeme karşıladı. Ödeme
  // oluşturulurken işaretlenir (aynı kalemi iki kişi seçemesin), ödeme
  // başarısız olur ya da iptal edilirse tekrar boşa çıkar.
  // Para hesabını ETKİLEMEZ — kalan tutar her zaman toplam eksi ödenen'dir;
  // burası yalnızca "bu kalemi kim üstlendi" bilgisidir.
  settledPaymentId String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  VOIDED // yanlış girilen nakit/POS ödemesi müdür tarafından iptal edildi
}

enum PaymentMethod {
  CARD
  CASH
}

model Payment {
  id          String        @id @default(cuid())
  amountCents Int           // tahsil edilen toplam (hesap payı + bahşiş)
  tipCents    Int           @default(0) // amountCents içindeki bahşiş kısmı; hesaptan düşülmez, personele gider
  payerName   String?
  method      PaymentMethod @default(CARD)
  status      PaymentStatus @default(PENDING)
  providerRef String?       // ödeme sağlayıcısının işlem/token referansı (ör. iyzico checkout token)
  recordedBy  String?       // nakit ödemeyi kaydeden personelin adı (hesap verebilirlik için)
  createdAt   DateTime      @default(now())
  paidAt      DateTime?
  voidedAt    DateTime?
  voidedBy    String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

/// Şubenin bizimle olan ticari ilişkisi.
enum SubscriptionStatus {
  TRIAL     // ücretsiz deneme sürüyor
  ACTIVE    // abonelik ödeniyor
  SUSPENDED // ödeme yok / ilişki durduruldu (elle çevrilir)
}

// iyzico'nun alt üye işyeri (subMerchant) tiplerine birebir karşılık gelir.
enum SubMerchantType {
  PERSONAL                       // şahıs (TC kimlik no ile)
  PRIVATE_COMPANY                // şahıs şirketi
  LIMITED_OR_JOINT_STOCK_COMPANY // limited / anonim şirket
}

enum StaffRole {
  OWNER   // platform sahibi (biz): kendi şubesinde müdür yetkisi + tüm şubeleri görme
  MANAGER
  WAITER
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  role         StaffRole @default(WAITER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
}

/// Gün sonu kasa kapanışı: sistemin beklediği nakit ile sayılan nakit karşılaştırılıp kaydedilir.
model DayClose {
  id                String   @id @default(cuid())
  date              String   // "YYYY-MM-DD" (Europe/Istanbul günü)
  expectedCashCents Int      // sistemdeki nakit tahsilat (bahşiş dahil, iptaller hariç)
  countedCashCents  Int      // personelin saydığı nakit
  cardCents         Int      // POS ile alınan kart (bilgi amaçlı)
  onlineCents       Int      // QR/iyzico ile alınan kart
  tipCents          Int
  note              String?
  closedBy          String
  createdAt         DateTime @default(now())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, date])
}
